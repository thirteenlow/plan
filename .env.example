# Copy to .env and fill in from Supabase → Project Settings → API.
# Use the PUBLISHABLE key (sb_publishable_…) or legacy anon key. Never the secret key (sb_secret_…):
# it bypasses row-level security, and the app refuses to start sync with one.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
