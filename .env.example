# Copy to .env and fill in from Supabase → Project Settings → API.
# Use the PUBLISHABLE key (sb_publishable_…) or legacy anon key. Never the secret key (sb_secret_…):
# it bypasses row-level security, and the app refuses to start sync with one.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: turns on notifications. The public half of the VAPID key pair (npx web-push generate-vapid-keys);
# the private half goes only in the send-reminders function secrets (supabase/006_reminders.sql).
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# Optional: Stripe's PUBLISHABLE key (pk_…, safe to ship) shows the Plan Pro payment form inside the web app instead
# of redirecting to Stripe. The secret key (sk_…) goes only in the Supabase function secrets.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
