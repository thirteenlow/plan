{
  "expo": {
    "name": "Plan",
    "slug": "plan-budget",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dearplan.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#B65CF4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dearplan.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Plan",
      "shortName": "Plan",
      "themeColor": "#F3F4F9",
      "backgroundColor": "#F3F4F9"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Plan lets you attach receipt photos to transactions.",
          "cameraPermission": "Plan uses the camera to photograph receipts."
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/splash-icon.png",
            "imageWidth": 140
          },
          "backgroundColor": "#F3F4F9",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0E111C"
          }
        }
      ]
    ],
    "scheme": "dearplan",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": false
        }
      },
      "eas": {
        "projectId": "38981fb8-f1c1-4c46-8be3-5c60b860da2e"
      }
    }
  }
}
